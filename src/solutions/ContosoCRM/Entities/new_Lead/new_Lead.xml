<?xml version="1.0" encoding="utf-8"?>
<Entity xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name LocalizedName="Lead" OriginalName="Lead">new_Lead</Name>
  <EntityInfo>
    <entity Name="new_Lead">
      <LocalizedNames>
        <LocalizedName description="Lead" languagecode="1033" />
      </LocalizedNames>
      <LocalizedCollectionNames>
        <LocalizedCollectionName description="Leads" languagecode="1033" />
      </LocalizedCollectionNames>
      <Descriptions>
        <Description description="Captures inbound leads before qualification into Opportunities." languagecode="1033" />
      </Descriptions>
      <attributes>
        <attribute PhysicalName="new_LeadId">
          <Type>primarykey</Type>
          <Name>new_LeadId</Name>
          <LogicalName>new_leadid</LogicalName>
        </attribute>
        <attribute PhysicalName="new_FullName">
          <Type>nvarchar</Type>
          <Name>new_FullName</Name>
          <LogicalName>new_fullname</LogicalName>
          <MaxLength>200</MaxLength>
        </attribute>
        <attribute PhysicalName="new_Email">
          <Type>nvarchar</Type>
          <Name>new_Email</Name>
          <LogicalName>new_email</LogicalName>
          <MaxLength>320</MaxLength>
        </attribute>
        <attribute PhysicalName="new_Company">
          <Type>nvarchar</Type>
          <Name>new_Company</Name>
          <LogicalName>new_company</LogicalName>
          <MaxLength>200</MaxLength>
        </attribute>
        <attribute PhysicalName="new_Source">
          <Type>picklist</Type>
          <Name>new_Source</Name>
          <LogicalName>new_source</LogicalName>
          <!-- 100000000=Web, 100000001=Referral, 100000002=Event, 100000003=Cold Call -->
        </attribute>
        <attribute PhysicalName="new_Status">
          <Type>picklist</Type>
          <Name>new_Status</Name>
          <LogicalName>new_status</LogicalName>
          <!-- 100000000=New, 100000001=Contacted, 100000002=Qualified, 100000003=Disqualified -->
        </attribute>
      </attributes>
    </entity>
  </EntityInfo>
</Entity>
