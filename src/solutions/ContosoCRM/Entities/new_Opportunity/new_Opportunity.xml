<?xml version="1.0" encoding="utf-8"?>
<Entity xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name LocalizedName="Opportunity" OriginalName="Opportunity">new_Opportunity</Name>
  <EntityInfo>
    <entity Name="new_Opportunity">
      <LocalizedNames>
        <LocalizedName description="Opportunity" languagecode="1033" />
      </LocalizedNames>
      <LocalizedCollectionNames>
        <LocalizedCollectionName description="Opportunities" languagecode="1033" />
      </LocalizedCollectionNames>
      <Descriptions>
        <Description description="Tracks sales opportunities through the pipeline from Qualification to Closed Won/Lost." languagecode="1033" />
      </Descriptions>
      <attributes>
        <attribute PhysicalName="new_OpportunityId">
          <Type>primarykey</Type>
          <Name>new_OpportunityId</Name>
          <LogicalName>new_opportunityid</LogicalName>
        </attribute>
        <attribute PhysicalName="new_Name">
          <Type>nvarchar</Type>
          <Name>new_Name</Name>
          <LogicalName>new_name</LogicalName>
          <MaxLength>200</MaxLength>
        </attribute>
        <attribute PhysicalName="new_EstimatedValue">
          <Type>money</Type>
          <Name>new_EstimatedValue</Name>
          <LogicalName>new_estimatedvalue</LogicalName>
        </attribute>
        <attribute PhysicalName="new_Stage">
          <Type>picklist</Type>
          <Name>new_Stage</Name>
          <LogicalName>new_stage</LogicalName>
          <!-- 100000000=Qualification, 100000001=Proposal, 100000002=Negotiation, 100000003=Closed Won, 100000004=Closed Lost -->
        </attribute>
        <attribute PhysicalName="new_CloseDate">
          <Type>datetime</Type>
          <Name>new_CloseDate</Name>
          <LogicalName>new_closedate</LogicalName>
        </attribute>
        <attribute PhysicalName="new_Probability">
          <Type>integer</Type>
          <Name>new_Probability</Name>
          <LogicalName>new_probability</LogicalName>
        </attribute>
        <attribute PhysicalName="new_AccountId">
          <Type>lookup</Type>
          <Name>new_AccountId</Name>
          <LogicalName>new_accountid</LogicalName>
          <LookupStyle>single</LookupStyle>
          <LookupTypes>
            <LookupType>account</LookupType>
          </LookupTypes>
        </attribute>
      </attributes>
    </entity>
  </EntityInfo>
</Entity>
