{
  "_readme": [
    "solutions.json — Power Platform solution registry for this repo.",
    "",
    "SINGLE-SOLUTION REPO  : Add exactly one entry.",
    "MULTI-SOLUTION REPO   : Add all solutions. Use deployOrder to control",
    "                        the sequential import sequence (1 = first).",
    "",
    "Fields per solution:",
    "  name              — unique solution name matching the PP environment",
    "  folder            — relative path to unpacked solution source",
    "  deployOrder       — integer controlling sequential deploy sequence (required)",
    "  dependsOn         — optional metadata only; documents logical prerequisites",
    "                      but does NOT affect deploy order (use deployOrder for that)",
    "  dataSchemaFile    — Config Migration schema XML; lives at src/solutions/{Name}/config-data-schema.xml",
    "                      Leave empty string '' if this solution has no config migration data.",
    "  deploymentSettings — per-environment deployment-settings JSON paths.",
    "                      Convention: src/solutions/{Name}/deployment-settings-{env}.json",
    "",
    "Tip: For a single-solution repo, set deployOrder to 1 and set",
    "     PP_SOLUTION_NAME repo variable to match the name here."
  ],
  "solutions": [
    {
      "name": "CoreSolution",
      "folder": "src/solutions/CoreSolution",
      "deployOrder": 1,
      "dependsOn": [],

      "dataSchemaFile": "src/solutions/CoreSolution/config-data-schema.xml",
      "deploymentSettings": {
        "dev":  "src/solutions/CoreSolution/deployment-settings-dev.json",
        "intg": "src/solutions/CoreSolution/deployment-settings-intg.json",
        "uat":  "src/solutions/CoreSolution/deployment-settings-uat.json",
        "frs":  "src/solutions/CoreSolution/deployment-settings-frs.json",
        "perf": "src/solutions/CoreSolution/deployment-settings-perf.json",
        "prod": "src/solutions/CoreSolution/deployment-settings-prod.json"
      }
    },
    {
      "name": "ExtensionA",
      "folder": "src/solutions/ExtensionA",
      "deployOrder": 2,
      "dependsOn": ["CoreSolution"],

      "dataSchemaFile": "",
      "deploymentSettings": {
        "dev":  "src/solutions/ExtensionA/deployment-settings-dev.json",
        "intg": "src/solutions/ExtensionA/deployment-settings-intg.json",
        "uat":  "src/solutions/ExtensionA/deployment-settings-uat.json",
        "frs":  "src/solutions/ExtensionA/deployment-settings-frs.json",
        "perf": "src/solutions/ExtensionA/deployment-settings-perf.json",
        "prod": "src/solutions/ExtensionA/deployment-settings-prod.json"
      }
    },
    {
      "name": "ExtensionB",
      "folder": "src/solutions/ExtensionB",
      "deployOrder": 3,
      "dependsOn": ["CoreSolution"],

      "dataSchemaFile": "",
      "deploymentSettings": {
        "dev":  "src/solutions/ExtensionB/deployment-settings-dev.json",
        "intg": "src/solutions/ExtensionB/deployment-settings-intg.json",
        "uat":  "src/solutions/ExtensionB/deployment-settings-uat.json",
        "frs":  "src/solutions/ExtensionB/deployment-settings-frs.json",
        "perf": "src/solutions/ExtensionB/deployment-settings-perf.json",
        "prod": "src/solutions/ExtensionB/deployment-settings-prod.json"
      }
    }
  ]
}
